{
  "name": "print-me-daddy",
  "productName": "Print Me Daddy",
  "version": "0.1.0",
  "description": "A cheeky chat window for printing things fast, hosted by Paige.",
  "main": "./out/main/index.js",
  "author": "Gav Weldon",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@fontsource/knewave": "5.3.0",
    "@fontsource/pacifico": "5.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vite": "7.3.7"
  },
  "build": {
    "appId": "com.gavweldon.printmedaddy",
    "productName": "Print Me Daddy",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "host/**",
          "icon/**",
          "brand/**"
        ]
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "icon": "assets/icon/icon.png",
      "target": [
        "nsis"
      ]
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
